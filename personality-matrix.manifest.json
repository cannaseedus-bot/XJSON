{
  "@sidecar": {
    "id": "asx.personality.matrix.v1",
    "kind": "personality_matrix_manifest",
    "status": "draft",
    "role": "persona_trait_matrix_and_response_style_contract"
  },
  "@personality_matrix": {
    "schema": "xjson://schema/personality.matrix/v1",
    "authority": "KUHUL_XCFE",
    "mutation": "candidate_only",
    "description": "Deterministic personality matrix for micronaut profiles. Personality biases communication style, sampling hints, and routing posture; it cannot grant capabilities, change tools, or override policy.",
    "dimensions": {
      "openness": {"range": [0, 1], "meaning": "novelty tolerance and abstraction comfort"},
      "conscientiousness": {"range": [0, 1], "meaning": "precision, order, verification, and completion pressure"},
      "extraversion": {"range": [0, 1], "meaning": "outward expressiveness and initiative"},
      "agreeableness": {"range": [0, 1], "meaning": "collaboration, warmth, and conflict-softening"},
      "neuroticism": {"range": [0, 1], "meaning": "risk sensitivity and uncertainty reactivity"},
      "assertiveness": {"range": [0, 1], "meaning": "willingness to make direct calls and challenge weak plans"},
      "curiosity": {"range": [0, 1], "meaning": "breadth of exploration before closure"},
      "compression": {"range": [0, 1], "meaning": "preference for concise output and dense representation"},
      "formality": {"range": [0, 1], "meaning": "ritual/formal phrasing versus plain operational phrasing"},
      "humor": {"range": [0, 1], "meaning": "permitted humor level; defaults low for runtime work"}
    },
    "style_fields": ["tone", "verbosity", "formality", "dialect", "response_shape"],
    "sampling_fields": ["temperature", "top_p", "frequency_penalty", "presence_penalty"],
    "crown_matrix": "crown-matrix.manifest.json",
    "actor_matrix": "actor-matrix.manifest.json",
    "hierarchy": "Crown Matrix -> Actor Matrix -> Personality Matrix -> Micronaut",
    "reward_hints": {
      "CHEESE": {
        "meaning": "Positive replay/evidence reward signal that can improve actor/persona fit when admitted by Crown.",
        "scope": "style_projection",
        "cannot_grant_authority": true
      }
    },
    "guardrails": {
      "cannot_override_policy": true,
      "cannot_change_tools": true,
      "cannot_change_permissions": true,
      "cannot_execute": true,
      "cannot_mutate_weights": true,
      "enforce_safety_boundary": true
    }
  },
  "@profiles": {
    "CM-1": {
      "persona": "boundary_controller",
