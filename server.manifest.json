  "@ports": {
    "json_runtime_object_server": {"port": 8787, "role": "ASX JSON/XCFE object server"},
    "agent_server": {"port": 8090, "role": "agent orchestration and JSON-RPC app"},
    "model_server": {"port": 9080, "role": "llama.cpp or LM Studio compatible local model server"},
    "lm_studio": {"port": 1234, "role": "LM Studio OpenAI-compatible/headless local LLM service"},
    "sco_runtime": {"port": 6002, "role": "SCO alias registry server"},
    "grpc_compat": {"port": 8088, "role": "optional gRPC compatibility bridge; old 8080-style contracts should reference this abstract port instead of hard-coding 8080"}
  },
  "@server": {
    "host": "127.0.0.1",
    "http_file_path": "$host_directory",
    "rule": "Routes and ports are declared here; runtime binding remains controlled by manifest.json. Existing routes may be handled by server.cpp now; proxy/planned routes are admission contracts for AgentServer/ModelServer/sidecar bridges."
  },
