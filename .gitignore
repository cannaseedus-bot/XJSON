/build-local/
**/build/
*.obj
*.o
*.exe
*.dll
*.pdb
*.ilk
*.lib
*.exp

# --- runtime / test artifacts ---
err.txt
out.txt
*.log
test.sqlite
*.bson
node_modules/
node-manifest-output.txt

# --- os ---
.DS_Store
Thumbs.db

