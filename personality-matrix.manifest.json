  },
  "@matrix_ops": {
    "blend": "Weighted average of active profile vectors for multi-micronaut routing.",
    "clamp": "Every trait and sampling value is clamped to declared bounds.",
    "route_bias": "Personality can bias rendering and lane choice only after intent/fold match.",
    "evolution": "Profile deltas are candidate-only and require replay, validation, CHEESE score, and Crown/Prime approval."
  },
  "@routes": [
    {"name": "personality_matrix", "method": "GET", "path": "/api/personality-matrix", "handler": "personality_matrix.describe", "status": "sidecar_contract"},
    {"name": "personality_profile", "method": "GET", "path": "/api/personality-matrix/profile", "args": ["id"], "handler": "personality_matrix.profile", "status": "sidecar_contract"},
    {"name": "personality_blend", "method": "POST", "path": "/api/personality-matrix/blend", "body": ["ids", "weights", "policy"], "handler": "personality_matrix.blend", "status": "sidecar_contract"},
    {"name": "personality_admit_delta", "method": "POST", "path": "/api/personality-matrix/admit-delta", "body": ["id", "delta", "evidence", "policy"], "handler": "personality_matrix.admit_delta", "status": "requires_policy"}
  ],
  "@agents": {
    "normal_agent_file": "../agents/personality-matrix.json",
    "ids": ["PERSONALITY-MATRIX", "PERSONA-ROUTER", "STYLE-BLENDER"]
  },
  "@folds": {
    "pop": ["load_profile_matrix", "load_requested_personas"],
    "wo": ["bind_traits", "bind_sampling", "bind_guardrails"],
    "yax": ["blend_active_profiles", "plan_response_style"],
    "sek": ["apply_style_bias_without_policy_mutation"],
    "chen": ["emit_persona_projection"],
    "xul": ["record_personality_event", "close_or_candidate_delta"]
  }
}
